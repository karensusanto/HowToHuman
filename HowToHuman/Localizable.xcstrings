    "**\"How do you...?\"**" : {
      "comment" : "A question that the user can ask an alien.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**”Bagaimana cara…?”**"
          }
        }
      }
    },
    "**Aliens, the humans have answered.**" : {
      "comment" : "A title displayed on the screen when the user is asked to share their experience.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Alien, para manusia telah memberikan jawaban.**"
          }
        }
      }
    },
    "**Help the aliens have a positive experience on Earth — or risk angering them.**" : {
      "comment" : "Additional text to be displayed in the warning banner at the top of the screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Bantu para alien mendapatkan pengalaman positif di Bumi — atau bersiap menghadapi kemurkaan mereka.**"
          }
        }
      }
    },
    "**Now, it's your turn, human.**" : {
      "comment" : "A title displayed on the screen before the user is asked to answer an alien's question.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sekarang giliranmu, manusia.**"
          }
        }
      }
    },
    "**Welcome back to the spaceship, aliens.**" : {
      "comment" : "A heading for the welcome screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Selamat datang kembali di pesawat luar angkasa, para alien.**"
          }
        }
      }
    },
    "**Would you revisit Earth?**" : {
      "comment" : "A question that asks if the user would visit Earth again.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Apakah kalian mau mengunjungi Bumi lagi?**"
